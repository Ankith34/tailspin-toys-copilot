---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';
import { getAllCategories } from '../lib/categories';

export const prerender = true;

const categoryParam = Astro.url.searchParams.get('category');
const publisherParam = Astro.url.searchParams.get('publisher');

const selectedCategoryId = categoryParam ? Number.parseInt(categoryParam, 10) : null;
const selectedPublisherId = publisherParam ? Number.parseInt(publisherParam, 10) : null;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());

const selectedCategory = categories.find((category) => category.id === selectedCategoryId) ?? null;
const selectedPublisher = publishers.find((publisher) => publisher.id === selectedPublisherId) ?? null;
const activeFilterLabel = [selectedCategory?.name, selectedPublisher?.name].filter(Boolean).join(' / ');
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg">
      <form method="get" class="flex flex-col gap-4 lg:flex-row lg:items-end" data-testid="filter-form">
        <div class="flex-1">
          <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">
            Filter by category
          </label>
          <select
            id="category-filter"
            name="category"
            data-testid="category-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All categories</option>
            {categories.map((category) => (
              <option value={category.id} selected={category.id === selectedCategoryId}>
                {category.name}
              </option>
            ))}
          </select>
        </div>

        <div class="flex-1">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">
            Filter by publisher
          </label>
          <select
            id="publisher-filter"
            name="publisher"
            data-testid="publisher-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id} selected={publisher.id === selectedPublisherId}>
                {publisher.name}
              </option>
            ))}
          </select>
        </div>

        <div class="flex gap-3">
          <button
            type="submit"
            data-testid="apply-filters"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Apply
          </button>

          <a
            href="/"
            data-testid="clear-filters"
            hidden={selectedCategory === null && selectedPublisher === null}
            class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Clear
          </a>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100" data-testid="games-heading">
        {activeFilterLabel ? `Featured Games for ${activeFilterLabel}` : 'Featured Games'}
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>

      <EmptyState
        text={activeFilterLabel ? `No games found for ${activeFilterLabel}.` : 'No games available at the moment.'}
        hidden={games.length > 0}
      />
    </div>
  </div>
</Layout>

<script>
  const gameCards: HTMLElement[] = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const gamesHeading = document.querySelector<HTMLElement>('[data-testid="games-heading"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="empty-state"]');
  const emptyStateText = document.querySelector<HTMLElement>('[data-testid="empty-state-text"]');
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearFilters = document.querySelector<HTMLElement>('[data-testid="clear-filters"]');
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="filter-form"]');

  const getSelectedValues = () => {
    const categoryValue = categoryFilter instanceof HTMLSelectElement ? categoryFilter.value : '';
    const publisherValue = publisherFilter instanceof HTMLSelectElement ? publisherFilter.value : '';
    return { categoryValue, publisherValue };
  };

  const getSelectedLabel = (categoryValue: string, publisherValue: string): string => {
    const categoryName = categoryFilter instanceof HTMLSelectElement
      ? categoryFilter.options[categoryFilter.selectedIndex]?.textContent?.trim() ?? ''
      : '';
    const publisherName = publisherFilter instanceof HTMLSelectElement
      ? publisherFilter.options[publisherFilter.selectedIndex]?.textContent?.trim() ?? ''
      : '';

    const selected = [categoryValue && categoryName !== 'All categories' ? categoryName : '', publisherValue && publisherName !== 'All publishers' ? publisherName : '']
      .filter(Boolean);

    return selected.join(' / ');
  };

  const updateResults = () => {
    const { categoryValue, publisherValue } = getSelectedValues();
    let matches = 0;

    for (const card of gameCards) {
      const matchesCategory = !categoryValue || card.getAttribute('data-category-id') === categoryValue;
      const matchesPublisher = !publisherValue || card.getAttribute('data-publisher-id') === publisherValue;
      const isVisible = matchesCategory && matchesPublisher;

      card.hidden = !isVisible;
      if (isVisible) matches += 1;
    }

    const label = getSelectedLabel(categoryValue, publisherValue);
    if (gamesHeading) {
      gamesHeading.textContent = label ? `Featured Games for ${label}` : 'Featured Games';
    }

    if (clearFilters) {
      clearFilters.hidden = !categoryValue && !publisherValue;
    }

    if (gamesGrid) {
      gamesGrid.hidden = matches === 0;
    }

    if (emptyState && emptyStateText) {
      emptyState.hidden = matches !== 0;
      if (matches === 0) {
        emptyStateText.textContent = label ? `No games found for ${label}.` : 'No games available at the moment.';
      }
    }
  };

  if (filterForm instanceof HTMLFormElement) {
    filterForm.addEventListener('submit', (event) => {
      event.preventDefault();

      const params = new URLSearchParams();
      const formData = new FormData(filterForm);

      for (const [key, value] of formData.entries()) {
        const stringValue = typeof value === 'string' ? value.trim() : '';
        if (stringValue) {
          params.set(key, stringValue);
        }
      }

      const query = params.toString();
      const nextUrl = `${window.location.pathname}${query ? `?${query}` : ''}`;
      window.history.pushState({}, '', nextUrl);
      updateResults();
    });
  }

  if (categoryFilter instanceof HTMLSelectElement && publisherFilter instanceof HTMLSelectElement) {
    categoryFilter.addEventListener('change', () => updateResults());
    publisherFilter.addEventListener('change', () => updateResults());
  }

  updateResults();
</script>
